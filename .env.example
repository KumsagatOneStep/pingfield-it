# Строка подключения к базе Neon (Neon → Connection Details → Pooled connection)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Секрет для подписи сессий: минимум 32 случайных символа.
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=

# Секрет ночного сброса демо-данных (Vercel Cron шлёт его в заголовке Authorization).
# Сгенерировать: openssl rand -hex 24
CRON_SECRET=
